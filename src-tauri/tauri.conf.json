{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heblearn",
  "version": "0.1.0",
  "identifier": "com.heblearn.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aprendiz de Hebraico",
        "width": 900,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/nikud/ai_daemon.py",
      "resources/nikud/python/python.exe",
      "resources/nikud/python/pythonw.exe",
      "resources/nikud/python/python314.dll",
      "resources/nikud/python/python3.dll",
      "resources/nikud/python/python314.zip",
      "resources/nikud/python/python314._pth",
      "resources/nikud/python/*.pyd",
      "resources/nikud/python/*.dll",
      "resources/nikud/python/site-packages/**/*",
      "resources/tts/he_IL-saspeech-medium.onnx",
      "resources/tts/he_IL-saspeech-medium.onnx.json"
    ]
  }
}
